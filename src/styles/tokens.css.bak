/* ============================================================
   INNOVIO v2.0 — Design Tokens (Premium Redesign)
   Brand identity preserved · Everything else renewed
   ============================================================ */
:root {
  /* ── Paleta de Marca (INTOCABLE) ── */
  --navy:        #0d3270;
  --navy-deep:   #071f50;
  --blue:        #1a4fa0;
  --blue-light:  #2563c4;
  --green:       #1b5e20;
  --green-mid:   #2e7d32;
  --green-light: #e8f5e9;
  --accent:      #00c2a8;
  --accent-dark: #00a88f;
  --gold:        #f0b429;
  --red:         #c0392b;
  --red-soft:    #fde8e6;

  /* ── Superficies ── */
  --logo-bg:     #ffffff;
  --bg:          #f4f6fb;
  --bg-subtle:   #eef1f8;
  --surface:     #ffffff;
  --surface-2:   #f8f9fc;
  --surface-3:   #f0f2f7;
  --border:      #e2e6f0;
  --border-light:#edf0f7;

  /* ── Texto (WCAG AA — alto contraste) ── */
  --text:        #0f172a;
  --text-mid:    #334155;
  --text-soft:   #64748b;
  --text-inverse:#ffffff;

  /* ── Sombras (5 niveles de profundidad) ── */
  --shadow-xs:   0 1px 2px rgba(13,50,112,0.04);
  --shadow-sm:   0 1px 3px rgba(13,50,112,0.06), 0 1px 2px rgba(13,50,112,0.04);
  --shadow-md:   0 4px 12px rgba(13,50,112,0.08), 0 2px 4px rgba(13,50,112,0.04);
  --shadow-lg:   0 12px 32px rgba(13,50,112,0.12), 0 4px 8px rgba(13,50,112,0.04);
  --shadow-xl:   0 20px 48px rgba(13,50,112,0.16), 0 8px 16px rgba(13,50,112,0.06);
  --focus:       0 0 0 3px rgba(0,194,168,0.28);
  --focus-blue:  0 0 0 3px rgba(26,79,160,0.24);

  /* ── Radios (escala consistente) ── */
  --r-xs:        4px;
  --r-sm:        6px;
  --r:           8px;
  --r-md:        12px;
  --r-lg:        16px;
  --r-xl:        24px;
  --r-full:      9999px;

  /* ── Tipografía ── */
  --font:        'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  --font-mono:   'JetBrains Mono', 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;

  /* Escala modular (más legible, mobile-first) */
  --fs-2xs:      11px;
  --fs-xs:       12px;
  --fs-sm:       13px;
  --fs-base:     15px;
  --fs-md:       16px;
  --fs-lg:       18px;
  --fs-xl:       20px;
  --fs-2xl:      24px;
  --fs-3xl:      30px;

  /* Line heights */
  --lh-tight:    1.2;
  --lh-snug:     1.35;
  --lh-normal:   1.5;
  --lh-relaxed:  1.65;

  /* Font weights */
  --fw-normal:   400;
  --fw-medium:   500;
  --fw-semibold: 600;
  --fw-bold:     700;
  --fw-extrabold:800;

  /* ── Espaciado (grid de 4px — más generoso en móvil) ── */
  --sp-1:        4px;
  --sp-2:        8px;
  --sp-3:        12px;
  --sp-4:        16px;
  --sp-5:        20px;
  --sp-6:        24px;
  --sp-8:        32px;
  --sp-10:       40px;
  --sp-12:       48px;
  --sp-16:       64px;

  /* ── Touch targets (mínimo 44px WCAG) ── */
  --touch-min:   44px;
  --touch-comfy: 48px;

  /* ── Transiciones premium ── */
  --ease-out:    cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --t-fast:      0.15s var(--ease-in-out);
  --t:           0.2s var(--ease-out);
  --t-slow:      0.35s var(--ease-out);

  /* ── Glassmorphism ── */
  --glass:       rgba(255,255,255,0.72);
  --glass-border:rgba(255,255,255,0.18);
  --glass-blur:  16px;

  /* ── Gradientes de marca ── */
  --grad-navy:   linear-gradient(135deg, #071f50 0%, #0d3270 50%, #1a4fa0 100%);
  --grad-accent: linear-gradient(135deg, #00c2a8 0%, #00a88f 100%);
  --grad-surface:linear-gradient(135deg, #f8f9fc 0%, #f0f2f7 100%);

  /* ── Sidebar ── */
  --sidebar-w:       260px;
  --sidebar-w-mini:  72px;

  /* ── Topbar ── */
  --topbar-h:    64px;

  /* ── Z-index scale ── */
  --z-dropdown:  100;
  --z-sticky:    200;
  --z-overlay:   500;
  --z-modal:     1000;
  --z-toast:     9000;
  --z-boot:      9999;
}
